# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# research inputs and derived artefacts. The scripts in research/ regenerate all of these,
# and the sample PNGs are re-downloadable from the CDN, so none of it belongs in the repo.
/images/
/research/variants/
/research/out/
/research/*.bin
/research/*.json
__pycache__/
*.pyc
